# Copia este archivo como ".env" y rellena lo que ya tengas.
# Si dejas las claves de IA vacías, el bot funciona en modo MOCK
# (respuestas de plantilla) para poder probar todo el flujo sin coste.

# --- IA (rellena una de las dos, no hace falta las dos) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- WhatsApp Cloud API (Meta Business Platform) ---
# Se obtienen en developers.facebook.com al crear la app de WhatsApp Business.
# Si los dejas vacíos, los mensajes de salida se imprimen en consola en vez
# de enviarse de verdad — útil para probar el webhook con curl sin gastar nada.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Token que tú mismo inventas y que Meta usa para verificar el webhook
# (debe coincidir con el que pongas en la configuración del webhook en Meta).
WHATSAPP_VERIFY_TOKEN=cambia-esto

# Número de WhatsApp del bot, en formato internacional sin "+" ni espacios
# (p. ej. 34600111222). Se usa para construir el botón wa.me de la landing
# de regalo (GET /r/{codigo}).
WHATSAPP_NUMERO_PUBLICO=

# URL pública donde está desplegado el bot (para los links de /r/{codigo} y
# los success_url/cancel_url de Stripe). En Railway puedes dejarlo vacío:
# se usa automáticamente RAILWAY_PUBLIC_DOMAIN.
PUBLIC_BASE_URL=

# --- Stripe (cobro real) ---
# Si dejas STRIPE_SECRET_KEY vacía, el bot funciona en modo simulado: entrega
# el pedido al instante sin pasar por ningún cobro real (útil para probar el
# flujo completo sin cuenta de Stripe). Para cobrar de verdad:
#   1. Crea una cuenta en https://dashboard.stripe.com (o usa una existente).
#   2. Copia tu clave secreta de modo TEST (empieza por sk_test_...) aquí
#      abajo para probar con tarjetas de prueba antes de cobrar dinero real.
#   3. Da de alta un endpoint de webhook en Stripe apuntando a
#      https://<tu-dominio>/webhook/stripe, escuchando el evento
#      "checkout.session.completed", y copia su "Signing secret" (whsec_...)
#      en STRIPE_WEBHOOK_SECRET.
#   4. Cuando quieras cobrar de verdad, cambia STRIPE_SECRET_KEY por tu
#      clave de modo LIVE (sk_live_...) y repite el paso 3 con un webhook
#      de modo live.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
