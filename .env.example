# Copia este archivo como ".env" y rellena lo que ya tengas.
# Si dejas las claves de IA vacías, el bot funciona en modo MOCK
# (respuestas de plantilla) para poder probar todo el flujo sin coste.

# --- IA (rellena una de las dos, no hace falta las dos) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- WhatsApp Cloud API (Meta Business Platform) ---
# Se obtienen en developers.facebook.com al crear la app de WhatsApp Business.
# Si los dejas vacíos, los mensajes de salida se imprimen en consola en vez
# de enviarse de verdad — útil para probar el webhook con curl sin gastar nada.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Token que tú mismo inventas y que Meta usa para verificar el webhook
# (debe coincidir con el que pongas en la configuración del webhook en Meta).
WHATSAPP_VERIFY_TOKEN=cambia-esto
